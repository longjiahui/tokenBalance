{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "add",
    "conn-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.deepseek.com/*" },
        { "url": "https://open.bigmodel.cn/*" }
      ]
    }
  ]
}